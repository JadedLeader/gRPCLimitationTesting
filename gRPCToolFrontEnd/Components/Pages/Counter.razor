    private async void HandleSessionRunReceived(StreamSessionRunResponse streamSessionRunResponse)
    {

        await InvokeAsync(async () =>
        {
            string overarching = streamSessionRunResponse.OverarchingPresetName;
            string trimmedPresetName = TrimPrefix(streamSessionRunResponse.PresetName, overarching);
            
            _savedPresetNames.TryAdd(trimmedPresetName, streamSessionRunResponse.SessionRunId);
            
            _overarchingPresetNames.Add(streamSessionRunResponse.OverarchingPresetName);

            if (_allPresets.Any(p => p.SessionRunId == streamSessionRunResponse.SessionRunId))
                return;
            
            _allPresets.Add(new PresetItem()
            {
                Overarching = streamSessionRunResponse.OverarchingPresetName, 
                SessionRunId = streamSessionRunResponse.SessionRunId, 
                PresetName = trimmedPresetName
            });
            
            StateHasChanged();
            
        });

    }

    private string TrimPrefix(string full, string prefix)
    {
        return full.StartsWith(prefix, StringComparison.Ordinal) ? full.Substring(prefix.Length) : full;
    }

    private void RefreshSavedPresets()
    {
        _savedPresetNames.Clear();
        
        Log.Information($"Refreshing saved presets");
        
        StressTestingPersistenceService.OnSessionRunResponse -= HandleSessionRunReceived;

        StressTestingPersistenceService.OnSessionRunResponse += HandleSessionRunReceived; 
        
        StressTestingPersistenceService.StartReceivingSessionRuns();
    }
    

    private async void HandleLatencyMeasurementsReceived(StreamLatencyMeasurementsResponse latencyMeasurements)
    {
        await InvokeAsync(async () =>
        {
            var testType = latencyMeasurements.TestType;
            var latencyMs = latencyMeasurements.Latency;

            if (testType == nameof(TestType.StreamingBatch))
            {
                Log.Information($"front end received result");

                _delays.Add(latencyMs);
                if (_delays.Count > MaxDataPoints) _delays.RemoveAt(0);

                _series = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "Batch Streaming Delay(s)",
                        Data = _delays.ToArray()
                    }
                };
            }
            else if (testType == nameof(TestType.StreamingSingle))
            {

                Log.Information($"front end received result");
                _streamingSingleDelays.Add(latencyMs);
                if (_streamingSingleDelays.Count > MaxDataPoints) _streamingSingleDelays.RemoveAt(0);

                _series2 = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "Single Streaming Delay(s)",
                        Data = _streamingSingleDelays.ToArray()
                    }
                };

            }
            else if (testType == nameof(TestType.UnarySingle))
            {

                Log.Information($"front end received result");
                _UnarySingleDelays.Add(latencyMs);
                if (_UnarySingleDelays.Count > MaxDataPoints) _UnarySingleDelays.RemoveAt(0);

                _series3 = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "Single Unary Delay(s)",
                        Data = _UnarySingleDelays.ToArray()
                    }
                };

            }
            else if (testType == nameof(TestType.UnaryBatch))
            {
                Log.Information($"front end received result");

                _UnaryBatchDelays.Add(latencyMs);
                if (_UnaryBatchDelays.Count > MaxDataPoints) _UnaryBatchDelays.RemoveAt(0);

                _series4 = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "Unary Batch Delay(s)",
                        Data = _UnaryBatchDelays.ToArray()
                    }
                };

            }

            StateHasChanged();
        });

    }
    
